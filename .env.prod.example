# Copy to `.env.prod` and fill in (file is gitignored via `.env*`).
#
# Prod DB commands:
#   pnpm db:push:prod   — sync schema directly (what you used if you never had ./drizzle migrations).
#   pnpm db:migrate:prod — apply SQL from ./drizzle (requires committed migrations + meta/_journal.json).
#     If the DB was already created with push, migrate may fail (tables already exist); keep using push
#     or use a fresh database and migrate once, then stick to migrations for future changes.
#   pnpm db:seed:prod, db:reset:prod, db:studio:prod — as named.

# Use sslmode=verify-full to match current node-pg behavior and silence the pg-connection-string v2 warning.
# (require/prefer are temporarily treated like verify-full; v3 will follow libpq semantics.)
# Alternative: ?uselibpqcompat=true&sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Logos on Vercel: set BLOB_READ_WRITE_TOKEN so uploads go to Blob; without it, /uploads/* is local-only and won’t persist on serverless.
# BLOB_READ_WRITE_TOKEN=

# Optional if you run other scripts that read these:
# AUTH_SECRET=
# AUTH_URL=https://your-app.vercel.app
