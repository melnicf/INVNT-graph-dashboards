{
  "name": "graph-dashboards",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:reset": "npx tsx src/db/reset.ts && drizzle-kit push && npx tsx src/db/seed.ts",
    "db:push:prod": "cross-env LOAD_ENV_PROD=1 drizzle-kit push",
    "db:migrate:prod": "cross-env LOAD_ENV_PROD=1 drizzle-kit migrate",
    "db:studio:prod": "cross-env LOAD_ENV_PROD=1 drizzle-kit studio",
    "db:seed:prod": "cross-env LOAD_ENV_PROD=1 npx tsx src/db/seed.ts",
    "db:reset:prod": "cross-env LOAD_ENV_PROD=1 npx tsx src/db/reset.ts && cross-env LOAD_ENV_PROD=1 drizzle-kit push && cross-env LOAD_ENV_PROD=1 npx tsx src/db/seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/blob": "^2.3.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
